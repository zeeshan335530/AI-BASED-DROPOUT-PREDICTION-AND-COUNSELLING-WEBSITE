      if(/stress|anxiet|depres|mental/.test(t)){
        return 'If stress or anxiety is present: recommend short breaks, breathing exercises, campus counselling, and reaching out to a trusted mentor. If severe, refer to a mental health professional.';
      }
      if(/career|job|intern|interview/.test(t)){
