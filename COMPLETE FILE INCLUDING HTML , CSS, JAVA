        const d=document.createElement('div'); d.className='item'; d.innerHTML=`<div><div style=\"font-weight:600\">${r.activity}</div><div class=\"muted small\">${r.time}</div></div><div style=\"text-align:right\"><input type=\"checkbox\" ${r.done? 'checked':''} data-i=\"${i}\"></div>`;
        el.appendChild(d);
        d.querySelector('input').addEventListener('change', (ev)=>{ const arr=storage.get('routines',[]); arr[i].done = ev.target.checked; storage.set('routines',arr); renderRoutine(); });
      });
    }
    document.getElementById('addRoutine').addEventListener('click', ()=>{
      const a=document.getElementById('r_activity').value.trim(); const t=document.getElementById('r_time').value.trim();
      if(!a) return alert('Add activity');
      const arr = storage.get('routines',[]); arr.push({activity:a,time:t,done:false}); storage.set('routines',arr); document.getElementById('r_activity').value=''; document.getElementById('r_time').value=''; renderRoutine();
    });
    document.getElementById('clearRoutine').addEventListener('click', ()=>{ if(confirm('Clear routines?')){storage.set('routines',[]); renderRoutine();}})
    document.getElementById('exportRoutine').addEventListener('click', ()=>{ const arr=storage.get('routines',[]); downloadBlob(JSON.stringify(arr,null,2),'routines.json','application/json'); })

    // --- ToDo ---
    function renderTodos(){ const arr=storage.get('todos',[]); const el=document.getElementById('todoList'); el.innerHTML=''; arr.forEach((t,i)=>{ const d=document.createElement('div'); d.className='item'; d.innerHTML=`<div><input type=\"checkbox\" ${t.done? 'checked':''} data-i=\"${i}\"> <span class=\"small\">${t.text}</span></div><div><button class=\"btn\" data-i=\"${i}\">Del</button></div>`; el.appendChild(d); d.querySelector('input').addEventListener('change', ev=>{ const a=storage.get('todos',[]); a[i].done = ev.target.checked; storage.set('todos',a); renderTodos(); }); d.querySelector('button').addEventListener('click', ()=>{ const a=storage.get('todos',[]); a.splice(i,1); storage.set('todos',a); renderTodos(); }); }); }
    document.getElementById('addTodo').addEventListener('click', ()=>{ const t=document.getElementById('todoText').value.trim(); if(!t) return; const arr=storage.get('todos',[]); arr.push({text:t,done:false}); storage.set('todos',arr); document.getElementById('todoText').value=''; renderTodos(); });
    document.getElementById('clearTodo').addEventListener('click', ()=>{ if(confirm('Clear to-dos?')){ storage.set('todos',[]); renderTodos(); }});
    document.getElementById('downloadTodo').addEventListener('click', ()=>{ const arr=storage.get('todos',[]); if(!arr.length) return alert('No items'); const text = arr.map(t=>`[${t.done? 'x':' '}] ${t.text}`).join('\n'); downloadBlob(text,'todo.txt','text/plain'); });

    // --- Resume builder ---
    document.getElementById('generateResume').addEventListener('click', ()=>{
      const data = collectResume(); const { jsPDF } = window.jspdf; const doc = new jsPDF(); let y=18; doc.setFontSize(14); doc.text(data.name,14,y); doc.setFontSize(10); doc.text(data.email + ' • ' + data.phone + (data.url? ' • '+data.url : ''),14,y+8); y+=18; doc.setFontSize(12); doc.text('Education',14,y); y+=6; doc.setFontSize(9);
      data.education.forEach(ed=>{ doc.text(`- ${ed}`,14,y); y+=6; }); y+=2; doc.setFontSize(12); doc.text('Skills',14,y); y+=6; doc.setFontSize(9); doc.text(data.skills.join(', '),14,y); y+=8; doc.setFontSize(12); doc.text('Projects',14,y); y+=6; doc.setFontSize(9); data.projects.forEach(p=>{ doc.text(`- ${p}`,14,y); y+=6; });
      doc.save((data.name||'resume').replace(/\s+/g,'_') + '.pdf');
    });
    document.getElementById('previewResume').addEventListener('click', ()=>{ const data = collectResume(); document.getElementById('resumePreview').innerText = JSON.stringify(data,null,2); });
    function collectResume(){ const name=document.getElementById('r_name').value||'Name'; const email=document.getElementById('r_email').value||''; const phone=document.getElementById('r_phone').value||''; const url=document.getElementById('r_url').value||''; const education = (document.getElementById('r_edu').value||'').split('\n').map(s=>s.trim()).filter(Boolean); const skills = (document.getElementById('r_skills').value||'').split(',').map(s=>s.trim()).filter(Boolean); const projects = (document.getElementById('r_projects').value||'').split('\n').map(s=>s.trim()).filter(Boolean); return {name,email,phone,url,education,skills,projects}; }

    // --- Feedback ---
    function renderFeedback(){ const fb = storage.get('feedback',[]).slice().reverse(); const el=document.getElementById('feedbackList'); el.innerHTML=''; fb.forEach(f=>{ const d=document.createElement('div'); d.className='item'; d.innerHTML=`<div><div style=\"font-weight:600\">${f.type}</div><div class=\"muted small\">${new Date(f.time).toLocaleString()}</div><div class=\"small\">${f.text}</div></div>`; el.appendChild(d); }); }
    document.getElementById('saveFbStudent').addEventListener('click', ()=>{ const t=document.getElementById('fb_student').value.trim(); if(!t) return alert('Enter feedback'); const arr=storage.get('feedback',[]); arr.push({type:'Student',text:t,time:new Date().toISOString()}); storage.set('feedback',arr); document.getElementById('fb_student').value=''; renderFeedback(); });
    document.getElementById('saveFbTeacher').addEventListener('click', ()=>{ const t=document.getElementById('fb_teacher').value.trim(); if(!t) return alert('Enter feedback'); const arr=storage.get('feedback',[]); arr.push({type:'Teacher',text:t,time:new Date().toISOString()}); storage.set('feedback',arr); document.getElementById('fb_teacher').value=''; renderFeedback(); });
    document.getElementById('downloadFbStudent').addEventListener('click', ()=>{ const arr = storage.get('feedback',[]).filter(f=>f.type==='Student'); if(!arr.length) return alert('No student feedback'); downloadBlob(arr.map(f=>`- ${f.time} : ${f.text}`).join('\n\n'),'student_feedback.txt','text/plain'); });
    document.getElementById('downloadFbTeacher').addEventListener('click', ()=>{ const arr = storage.get('feedback',[]).filter(f=>f.type==='Teacher'); if(!arr.length) return alert('No teacher feedback'); downloadBlob(arr.map(f=>`- ${f.time} : ${f.text}`).join('\n\n'),'teacher_feedback.txt','text/plain'); });

    // --- Reset all ---
    document.getElementById('resetAll').addEventListener('click', ()=>{ if(confirm('Reset all local data?')){ localStorage.clear(); sessionStorage.clear(); init(); showAuthOverlay(true); setAuthMode('login'); }});

    // --- utilities and initialization ---
    function init(){ renderHistory(); renderSessions(); renderRoutine(); renderTodos(); renderFeedback(); updateHome(); loadChatSample(); }
    function loadChatSample(){
      // friendly initial message
      addBubble('Hi — I am the counselling assistant. Ask about attendance, GPA, assignments, study plans, stress, or careers. The chat is stored locally only.', 'bot');
    }
    init();

  </script>
</body>
</html>
