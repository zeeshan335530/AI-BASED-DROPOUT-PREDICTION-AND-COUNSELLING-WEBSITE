<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Minimal Student Dashboard — Colorful</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    /* ---- Theme variables and transition ---- */
    :root{
      /* Colorful light theme (default) */
      --bg-1: #fff7ed; /* warm */
      --bg-2: #eef2ff; /* cool */
      --card: #ffffff;
      --muted: #6b7280;
      --accent: #06b6d4; /* cyan */
      --accent2: #f472b6; /* pink */
      --accent3: #f59e0b; /* amber */
      --glass: rgba(2,6,23,0.02);
      --text: #0f1724;
      --shadow: 0 6px 20px rgba(15,23,36,0.06);
      --border: rgba(15,23,36,0.03);
      --btn-text: #ffffff;
      --login-overlay: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(255,255,255,0.9));
      --chat-bg: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(255,255,255,0.95));
    }

    /* dark theme - toggled with .theme-dark on body */
    body.theme-dark{
      --bg-1: #0f1724;
      --bg-2: #071129;
      --card: #0b1220;
      --muted: #94a3b8;
      --accent: #22d3ee;
      --accent2: #fb7185;
      --accent3: #f59e0b;
      --glass: rgba(255,255,255,0.03);
      --text: #e6eef6;
      --shadow: 0 6px 20px rgba(2,6,23,0.6);
      --border: rgba(255,255,255,0.04);
      --btn-text: #06202a;
      --login-overlay: linear-gradient(180deg, rgba(2,6,23,0.95), rgba(2,6,23,0.97));
      --chat-bg: linear-gradient(180deg, rgba(7,12,20,0.95), rgba(7,12,20,0.9));
    }

    /* Animated transitions when switching theme */
    * { box-sizing: border-box; transition: background 450ms ease, color 450ms ease, border-color 350ms ease, box-shadow 350ms ease; }
    html,body{height:100%;margin:0;background:linear-gradient(180deg,var(--bg-1) 0%, var(--bg-2) 100%);color:var(--text); font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;}
    .app{display:grid;grid-template-columns:260px 1fr;gap:20px;min-height:100vh;padding:20px}
    .sidebar{background:linear-gradient(180deg, rgba(255,255,255,0.8), rgba(255,255,255,0.95));padding:18px;border-radius:12px;display:flex;flex-direction:column;gap:12px;border:1px solid var(--border);box-shadow:var(--shadow)}
    body.theme-dark .sidebar{ background: linear-gradient(180deg, rgba(11,18,32,0.6), rgba(7,10,20,0.6)); }
    .brand{font-weight:700;font-size:18px;color:var(--accent)}
    .nav{display:flex;flex-direction:column;gap:6px;margin-top:6px}
    .nav button{background:transparent;border:none;color:var(--muted);padding:10px;border-radius:8px;text-align:left;cursor:pointer}
    .nav button.active{color:var(--text);background:linear-gradient(90deg, rgba(6,182,212,0.08), rgba(244,114,182,0.04))}
    .main{display:flex;flex-direction:column;gap:16px}
    .header{display:flex;justify-content:space-between;align-items:center}
    .card{background:var(--card);padding:16px;border-radius:12px;box-shadow:var(--shadow);border:1px solid var(--border)}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
    .counter{display:flex;flex-direction:column;gap:8px}
    .count{font-size:28px;font-weight:700;color:var(--accent);transition:all .4s}
    .tiny{font-size:12px;color:var(--muted)}
    .animated-bar{height:8px;background:linear-gradient(90deg,var(--accent), var(--accent2));border-radius:999px;transform-origin:left;animation:grow 1.2s ease forwards}
    @keyframes grow{from{transform:scaleX(0.02)} to{transform:scaleX(1)}}
    /* form styles */
    label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px}
    input,select,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text)}
    .row{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
    .btn{padding:10px 12px;border-radius:8px;border:none;cursor:pointer;background:linear-gradient(90deg,var(--accent), var(--accent2));color:var(--btn-text);font-weight:600}
    .muted{color:var(--muted)}
    .list{display:flex;flex-direction:column;gap:8px}
    .item{display:flex;justify-content:space-between;align-items:center;padding:8px;border-radius:8px;background:linear-gradient(180deg, rgba(2,6,23,0.01), rgba(2,6,23,0.02));border:1px solid var(--border)}
    body.theme-dark .item{ background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.015));}
    .small{font-size:13px}
    .center{display:flex;align-items:center;gap:10px}
    footer{opacity:.8;font-size:12px;text-align:center;margin-top:20px}
    /* login overlay */
    .overlay{position:fixed;inset:0;background:var(--login-overlay);Display:flex;align-items:center;justify-content:center;z-index:999}
    .login-card{width:360px;background:linear-gradient(180deg,#ffffff,#fffbf7);padding:20px;border-radius:12px;box-shadow:0 10px 40px rgba(2,6,23,0.08);border:1px solid var(--border)}
    body.theme-dark .login-card{ background: linear-gradient(180deg,#071023,#081025); color:var(--text); }
    .login-card h3{margin:0 0 10px 0}
    .tiny-muted{font-size:12px;color:var(--muted)}
    .logoutBtn{background:transparent;border:1px solid var(--border);padding:6px 10px;border-radius:8px;color:var(--muted);cursor:pointer}
    /* responsive */
    @media (max-width:880px){.app{grid-template-columns:1fr;}.sidebar{flex-direction:row;overflow:auto;padding:10px}.nav{flex-direction:row;gap:8px}.row{grid-template-columns:1fr}}
    /* Chatbot styles (counselling) */
    .chat-card{margin-top:12px;border-radius:10px;padding:12px;background:var(--chat-bg);border:1px solid var(--border);box-shadow:var(--shadow)}
    .chat-window{height:220px;overflow:auto;padding:8px;display:flex;flex-direction:column;gap:8px;border-radius:8px;background:transparent}
    .bubble{max-width:78%;padding:8px 10px;border-radius:12px;line-height:1.3}
    .bubble.user{align-self:flex-end;background:linear-gradient(90deg,var(--accent),var(--accent2));color:var(--btn-text)}
    .bubble.bot{align-self:flex-start;background:linear-gradient(90deg, rgba(0,0,0,0.03), rgba(0,0,0,0.02));color:var(--text);border:1px solid var(--border)}
    .chat-controls{display:flex;gap:8px;margin-top:8px}
    .theme-toggle{padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:transparent;cursor:pointer;color:var(--muted)}
    .save-chat{background:linear-gradient(90deg,var(--accent3), var(--accent2)); color:var(--btn-text); border:none; padding:8px 10px;border-radius:8px; cursor:pointer}
    /* subtle animation for switching theme icon */
    .theme-toggle .icon{display:inline-block;transition:transform 300ms ease}
    .theme-toggle[data-theme="dark"] .icon{transform:rotate(180deg)}

    /* Custom style for simulated OTP input alignment */
    .otp-control {
      display: flex;
      gap: 8px;
    }
    .otp-control button {
      flex-shrink: 0;
      width: 120px;
    }
  </style>
</head>
<body>
  <div id="loginOverlay" class="overlay" style="display:none">
    <div class="login-card">
      <h3>Sign in to Dashboard</h3>
      <div class="tiny-muted">Create an account or sign in. Data will remain local to your browser.</div>
      
      <div style="margin-top:12px" id="signupFields" style="display:none;">
        <div style="margin-top:8px">
          <label>Full Name</label>
          <input id="auth_name" placeholder="Full Name" />
        </div>
        <div style="margin-top:8px">
          <label>Email</label>
          <input id="auth_email" type="email" placeholder="email@example.com" />
        </div>
      </div>
      <div style="margin-top:12px">
        <label>Username</label>
        <input id="auth_user" placeholder="username" />
      </div>
      <div style="margin-top:8px">
        <label>Password</label>
        <input id="auth_pass" type="password" placeholder="password" />
      </div>

      <div style="margin-top:8px; display:none;" id="otpControlGroup">
        <label>CAPTHA (4-digit simulated)</label>
        <div class="otp-control">
          <input id="auth_otp" type="text" placeholder="####" maxlength="4" style="width:100%"/>
          <button class="btn" id="sendOtpBtn" style="background:var(--accent3); color:var(--btn-text);">Enter Captha</button>
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:12px">
        <button class="btn" id="loginBtn">Login</button>
        <button class="btn" id="signupBtn">Sign Up</button>
        <button class="logoutBtn" id="guestBtn">Continue as Guest</button>
      </div>
      <div id="authMsg" class="tiny-muted" style="margin-top:10px"></div>
    </div>
  </div>

  <div class="app" id="appRoot">
    <aside class="sidebar card">
      <div class="brand">Student Minimal Dashboard</div>
      <div class="muted small">A compact dashboard for student support tools</div>
      <nav class="nav" id="nav">
        <button data-page="home" class="active">Home</button>
        <button data-page="dropout">Dropout Prediction</button>
        <button data-page="counselling">Student Counselling</button>
        <button data-page="routine">Daily Routine Tracker</button>
        <button data-page="todo">To-Do Maker</button>
        <button data-page="resume">Resume Builder</button>
        <button data-page="feedback">Feedback</button>
      </nav>
      <div style="margin-top:auto;display:flex;flex-direction:column;gap:6px">
        <small class="muted">Data stored locally in browser (localStorage)</small>
        <button class="btn" id="resetAll">Reset All Data</button>
      </div>
    </aside>

    <main class="main">
      <header class="header">
        <div class="card" style="flex:1">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <div>
              <div style="font-weight:800"><h1>IIMT COLLEGE  OF ENGINEERING, GREATER NOIDA</h1></div>
              <div class="muted small">A minimal dashboard to predict student dropout risk and provide counseling by developing an AI-based system.
</div>
            </div>
            <div style="text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:8px">
              <div class="tiny-muted" id="userDisplay">v1.0 • Minimal</div>
              <div style="display:flex;gap:8px;align-items:center">
                <button id="logoutBtn" class="logoutBtn" style="display:none">Logout</button>
                <button id="themeToggleBtn" class="theme-toggle" title="Toggle theme" aria-label="Toggle theme">
                  <span class="icon">🌓</span> <small id="themeLabel" style="margin-left:6px">Colorful</small>
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <section id="pages" style="display:grid">
        <div data-page="home" class="card page">
          <h2 style="margin:0 0 8px 0">Home — Overview</h2>
          <div class="grid">
            <div class="card">
              <div class="counter">
                <div class="tiny">Dropout predictions (last 30)</div>
                <div class="count" id="countTotal">0</div>
                <div class="tiny">Low / Medium / High risk</div>
                <div style="display:flex;gap:6px;margin-top:8px">
                  <div style="flex:1"><div class="tiny">Low</div><div class="animated-bar" id="barLow" style="width:100%"></div></div>
                  <div style="flex:1"><div class="tiny">Medium</div><div class="animated-bar" id="barMed" style="width:80%"></div></div>
                  <div style="flex:1"><div class="tiny">High</div><div class="animated-bar" id="barHigh" style="width:60%"></div></div>
                </div>
              </div>
            </div>
            <div class="card">
              <div class="tiny">Quick actions</div>
              <div style="display:flex;gap:8px;margin-top:12px">
                <button class="btn" onclick="openPage('dropout')">New Prediction</button>
                <button class="btn" onclick="openPage('resume')">Build Resume</button>
              </div>
            </div>
            <div class="card">
              <div class="tiny">Project details</div>
              <div style="margin-top:8px" class="muted small">This minimal dashboard demonstrates a client-side toolkit for student dropout prediction, counselling, routine tracking, to-do management, resume generation, and feedback capture. All data is stored locally (no server).</div>
            </div>
          </div>
        </div>

        <div data-page="dropout" class="card page" style="display:none">
          <h2>Dropout Prediction</h2>
          <div class="row" style="margin-bottom:12px">
            <div>
              <label>Student name</label>
              <input id="s_name" placeholder="Full name" />
            </div>
            <div>
              <label>Student ID</label>
              <input id="s_id" placeholder="ID or roll no" />
            </div>
          </div>

          <div class="row" style="margin-bottom:12px">
            <div>
              <label>Attendance %</label>
              <input id="attendance" type="number" min="0" max="100" value="85" />
            </div>
            <div>
              <label>GPA (0-10)</label>
              <input id="gpa" type="number" min="0" max="10" step="0.01" value="7.2" />
            </div>
          </div>

          <div class="row" style="margin-bottom:12px">
            <div>
              <label>Assignments completed %</label>
              <input id="assignments" type="number" min="0" max="100" value="75" />
            </div>
            <div>
              <label>Engagement score (0-100)</label>
              <input id="engagement" type="number" min="0" max="100" value="60" />
            </div>
          </div>

          <!-- NEW DETAILED PARAMETERS (added, kept in same visual style) -->
          <div class="row" style="margin-bottom:12px">
            <div>
              <label>Parental education</label>
              <select id="parentEdu">
                <option value="2">Postgraduate or above</option>
                <option value="1">High school / Undergraduate</option>
                <option value="0">Primary or less</option>
              </select>
            </div>
            <div>
              <label>Financial stress (0-100)</label>
              <input id="financialStress" type="number" min="0" max="100" value="30" />
            </div>
          </div>

          <div class="row" style="margin-bottom:12px">
            <div>
              <label>Past backlogs / arrears (count)</label>
              <input id="backlogs" type="number" min="0" step="1" value="0" />
            </div>
            <div>
              <label>Health / Stress indicator (0-100)</label>
              <input id="healthStress" type="number" min="0" max="100" value="20" />
            </div>
          </div>

          <div class="row" style="margin-bottom:12px">
            <div>
              <label>Extra-curricular engagement (0-100)</label>
              <input id="extracurricular" type="number" min="0" max="100" value="40" />
            </div>
            <div>
              <label>Socioeconomic risk</label>
              <select id="socio">
                <option value="0">Low</option>
                <option value="0.5">Medium</option>
                <option value="1">High</option>
              </select>
            </div>
          </div>

          <div style="display:flex;gap:8px;margin-bottom:12px">
            <button class="btn" id="predictBtn">Predict</button>
            <button class="btn" id="downloadReport">Download Report</button>
          </div>

          <div style="display:grid;grid-template-columns:1fr 320px;gap:12px">
            <div class="card">
              <div id="predictionResult"><div class="muted">No prediction yet</div></div>
            </div>
            <div class="card">
              <div class="tiny">History</div>
              <div id="historyList" style="margin-top:8px;max-height:280px;overflow:auto"></div>
              <div style="display:flex;gap:8px;margin-top:8px">
                <button class="btn" id="exportCSV">Export CSV</button>
                <button class="btn" id="clearHistory">Clear</button>
              </div>
            </div>
          </div>
        </div>

        <div data-page="counselling" class="card page" style="display:none">
          <h2>Student Counselling</h2>
          <div class="row">
            <div>
              <label>Student</label>
              <input id="c_student" placeholder="Name or ID" />
            </div>
            <div>
              <label>Type</label>
              <select id="c_type"><option>Academic</option><option>Personal</option><option>Career</option></select>
            </div>
          </div>
          <div style="margin-top:8px">
            <label>Notes / Session summary</label>
            <textarea id="c_notes" rows="4" placeholder="Counsellor notes and suggested actions"></textarea>
          </div>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button class="btn" id="saveCounsel">Save Session</button>
            <button class="btn" id="exportCounsel">Export Sessions</button>
          </div>
          <div style="margin-top:12px">
            <div class="tiny">Saved sessions</div>
            <div id="sessionList" style="margin-top:8px;max-height:120px;overflow:auto"></div>
          </div>

          <div class="chat-card card" id="chatCard" style="margin-top:12px">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <div style="font-weight:700">Counselling Chatbot</div>
              <div class="muted small">quick replies • local only</div>
            </div>
            <div class="chat-window" id="chatWindow" aria-live="polite"></div>
            <div style="display:flex;gap:8px;margin-top:8px">
              <input id="chatInput" placeholder="Ask about attendance, study plan, stress, career..." style="flex:1;padding:10px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text)"/>
              <button class="btn" id="sendChat">Send</button>
              <button class="save-chat" id="saveChatNotes" title="Save chat as counselling session">Save Chat</button>
            </div>
            <div style="display:flex;gap:8px;margin-top:8px">
              <button class="theme-toggle" id="clearChat" title="Clear chat">Clear</button>
              <small class="muted" style="margin-left:auto">Bot uses simple heuristics to provide suggestions</small>
            </div>
          </div>

        </div>

        <div data-page="routine" class="card page" style="display:none">
          <h2>Daily Routine Tracker</h2>
          <div class="row">
            <div>
              <label>Activity</label>
              <input id="r_activity" placeholder="e.g. Study Data Structures" />
            </div>
            <div>
              <label>Time (HH:MM)</label>
              <input id="r_time" placeholder="08:30" />
            </div>
          </div>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button class="btn" id="addRoutine">Add</button>
            <button class="btn" id="exportRoutine">Export</button>
            <button class="btn" id="clearRoutine">Clear</button>
          </div>
          <div style="margin-top:12px">
            <div id="routineList" class="list"></div>
          </div>
        </div>

        <div data-page="todo" class="card page" style="display:none">
          <h2>To-Do List Maker</h2>
          <div style="display:flex;gap:8px">
            <input id="todoText" placeholder="Add a task" />
            <button class="btn" id="addTodo">Add</button>
          </div>
          <div style="margin-top:10px">
            <div id="todoList" class="list"></div>
            <div style="display:flex;gap:8px;margin-top:8px">
              <button class="btn" id="downloadTodo">Download .txt</button>
              <button class="btn" id="clearTodo">Clear</button>
            </div>
          </div>
        </div>

        <div data-page="resume" class="card page" style="display:none">
          <h2>Resume Builder (Engineering)</h2>
          <div class="row">
            <div>
              <label>Full name</label>
              <input id="r_name" placeholder="Your name" />
            </div>
            <div>
              <label>Email</label>
              <input id="r_email" placeholder="you@example.com" />
            </div>
          </div>
          <div class="row">
            <div>
              <label>Phone</label>
              <input id="r_phone" placeholder="+91 98765 43210" />
            </div>
            <div>
              <label>GitHub / Portfolio URL</label>
              <input id="r_url" placeholder="github.com/you" />
            </div>
          </div>
          <div style="margin-top:8px">
            <label>Education (comma separated: Degree | Institute | Year | CPI)</label>
            <input id="r_edu" placeholder="B.Tech | ABC College | 2024 | 8.1" />
          </div>
          <div style="margin-top:8px">
            <label>Skills (comma separated)</label>
            <input id="r_skills" placeholder="Python, C, Data Structures, ML" />
          </div>
          <div style="margin-top:8px">
            <label>Projects (one per line: Title - short description)</label>
            <textarea id="r_projects" rows="4" placeholder="Project A - built ..."></textarea>
          </div>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button class="btn" id="generateResume">Generate PDF</button>
            <button class="btn" id="previewResume">Preview JSON</button>
          </div>
          <div id="resumePreview" style="margin-top:12px"></div>
        </div>

        <div data-page="feedback" class="card page" style="display:none">
          <h2>Feedback</h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div>
              <label>Student feedback</label>
              <textarea id="fb_student" rows="6" placeholder="Suggestions for teachers or system"></textarea>
              <div style="display:flex;gap:8px;margin-top:8px">
                <button class="btn" id="saveFbStudent">Submit</button>
                <button class="btn" id="downloadFbStudent">Download</button>
              </div>
            </div>
            <div>
              <label>Teacher feedback</label>
              <textarea id="fb_teacher" rows="6" placeholder="Suggestions about students or courses"></textarea>
              <div style="display:flex;gap:8px;margin-top:8px">
                <button class="btn" id="saveFbTeacher">Submit</button>
                <button class="btn" id="downloadFbTeacher">Download</button>
              </div>
            </div>
          </div>
          <div style="margin-top:8px">
            <div class="tiny">Submitted feedback</div>
            <div id="feedbackList" style="margin-top:8px;max-height:220px;overflow:auto"></div>
          </div>
        </div>

      </section>

      <footer class="muted">Built for demo • All data local • Open-source minimal UI</footer>
    </main>
  </div>

  <script>
    // --- simple auth helpers (kept from the file, unchanged behaviour) ---
    const authOverlay = document.getElementById('loginOverlay');
    const loginBtn = document.getElementById('loginBtn');
    const signupBtn = document.getElementById('signupBtn');
    const guestBtn = document.getElementById('guestBtn');
    const authMsg = document.getElementById('authMsg');
    const userDisplay = document.getElementById('userDisplay');
    const logoutBtn = document.getElementById('logoutBtn');

    // NEW ELEMENTS FOR SIGNUP/OTP
    const signupFields = document.getElementById('signupFields');
    const otpControlGroup = document.getElementById('otpControlGroup');
    const sendOtpBtn = document.getElementById('sendOtpBtn');
    const authName = document.getElementById('auth_name');
    const authEmail = document.getElementById('auth_email');
    const authOtp = document.getElementById('auth_otp');
    let isSignupMode = false;
    let simulatedOTP = null;

    function authStorageGet(){ try{return JSON.parse(localStorage.getItem('dashboard_users')||'{}')}catch(e){return {}} }
    // Modified to store name and email
    function authStorageSet(obj){ localStorage.setItem('dashboard_users', JSON.stringify(obj)) }

