    // --- improved dropout prediction model (detailed factors) ---
    function predict(features){
      // normalize and derive risk-contributing terms
      const a = features.attendance/100; // higher attendance -> lower risk
      const g = features.gpa/10;         // higher GPA -> lower risk
      const asg = features.assignments/100;
      const e = features.engagement/100;
      const socio = features.socio;      // already 0..1, higher -> more risk

      // new normalized features
      // parental education: 2 (highest) -> convert so higher numeric value reduces risk
      // We'll compute pe_risk = (2 - val)/2 so pe_risk in [0,1], higher means more risk
      const pe_risk = (2 - (features.parentEdu||0))/2;

      const fin = (features.financialStress||0)/100; // higher -> more risk
      // backlogs: convert to a 0..1 scale assuming 0..6 typical range; cap at 6
      const back = Math.min(6, features.backlogs||0) / 6;
      const health = (features.healthStress||0)/100; // higher stress -> more risk
      const extra = (features.extracurricular||0)/100; // higher -> lower risk

      // Weights chosen heuristically to balance contributions
      // negative weights reduce risk when feature improves (attendance, gpa, assignments, engagement, extracurricular)
      // positive weights increase risk when feature worsens (socio, financial stress, backlogs, health, parental-edu risk)
      const w = {
        attendance: -1.1,
        gpa: -1.0,
        assignments: -0.8,
        engagement: -0.7,
        extracurricular: -0.6,
        socio: 1.6,
        financial: 1.2,
        backlogs: 0.9,
        health: 0.9,
        parentalRisk: 1.0,
        bias: 0.4
      };

      const score = w.attendance * a
                  + w.gpa * g
                  + w.assignments * asg
                  + w.engagement * e
                  + w.extracurricular * extra
                  + w.socio * socio
                  + w.financial * fin
                  + w.backlogs * back
                  + w.health * health
                  + w.parentalRisk * pe_risk
                  + w.bias;

      const prob = 1/(1+Math.exp(-score)); // logistic mapping to [0,1]
      let level = 'low';
      if(prob>0.70) level='high';
      else if(prob>0.40) level='med';

      const suggestions = generateSuggestions(level, features, {pe_risk, fin, back, health, extra});
      return {prob: +(prob.toFixed(3)), level, suggestions};
    }

    function generateSuggestions(level, f, norms){
      const base = [];
      if(level==='high'){
        base.push('Immediate counselling recommended.');
        base.push('Increase attendance — set weekly check-ins and targets (aim 80%+).');
        base.push('Meet academic advisor to rework course load and tackle backlog items.');
        base.push('Break assignments into small tasks and use reminders.');
      } else if(level==='med'){
        base.push('Monitor progress closely and set a short-term improvement plan (4–6 weeks).');
        base.push('Use peer study groups, office hours, and scheduled revision.');
        base.push('Set weekly measurable goals and review.');
      } else {
        base.push('Student is low risk — keep current routine and maintain mentorship.');
        base.push('Encourage applied projects and career activities to strengthen engagement.');
      }

      // Tailored tips based on new factors
      if(f.gpa < 6.5) base.push('GPA below 6.5: prioritize concept revision, small projects, and timed practice tests.');
      if(f.assignments < 70) base.push('Low assignment completion: split tasks into focused 2-hour sessions and track progress.');
      if(norms.fin > 0.6) base.push('Financial stress is high: consider financial aid, scholarships, or fee deferment conversations.');
      if(norms.back > 0.33) base.push('Multiple backlogs detected: create a backlog-clear schedule and seek targeted tutoring.');
      if(norms.health > 0.5) base.push('High stress/health indicators: recommend campus counselling, stress management techniques, and medical checkups.');
      if(norms.parentalRisk > 0.6) base.push('Lower parental education support: provide extra academic mentoring and parental outreach programs.');
      if(norms.extra < 0.3) base.push('Low extra-curricular engagement: encourage balanced activities to improve motivation and campus connection.');

      return base.slice(0, 8); // limit suggestions to a manageable number
    }

